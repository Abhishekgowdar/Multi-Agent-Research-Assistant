# AI Provider: Choose "gemini" or "groq" (both FREE!)
LLM_PROVIDER=groq

# Google Gemini API Key (FREE)
# Get it from: https://makersuite.google.com/app/apikey
# OR use personal Gmail: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (FREE & FASTER!) - RECOMMENDED
# Get it from: https://console.groq.com/keys
# Works with any email (no restrictions)
GROQ_API_KEY=your_groq_api_key_here

# Optional: PubMed Email (for better rate limits)
PUBMED_EMAIL=your.email@example.com

# Optional: Semantic Scholar API Key (free, but higher limits with key)
# Get it from: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=optional_key_here

# Optional: IEEE Xplore API Key (FREE)
# Get it from: https://developer.ieee.org/member/register
IEEE_API_KEY=your_ieee_key_here

# Application Settings
LOG_LEVEL=INFO
MAX_PAPERS_PER_SEARCH=50
VECTOR_DB_PATH=./data/chroma_db

# Web Server
API_HOST=0.0.0.0
API_PORT=8000
